# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URLs used when creating a Checkout session / account links. Must be publicly
# reachable (HTTPS) in production for webhooks and Stripe redirects to work.
SUCCESS_URL=http://localhost:5173/success
CANCEL_URL=http://localhost:5173/

# Wise (payouts to Panama or other bank rails)
WISE_API_TOKEN=your_wise_api_token
WISE_PROFILE_ID=your_wise_profile_id
WISE_API_BASE=https://api.transferwise.com

PORT=4242
