# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URLs used when creating a Checkout session / account links. Must be publicly
# reachable (HTTPS) in production for webhooks and Stripe redirects to work.
SUCCESS_URL=http://localhost:5173/success
CANCEL_URL=http://localhost:5173/

# Wise (payouts to Panama or other bank rails)
WISE_API_TOKEN=your_wise_api_token
WISE_PROFILE_ID=your_wise_profile_id
WISE_API_BASE=https://api.transferwise.com

# Wompi (Colombia: PSE bank transfers, Nequi, Bancolombia Transfer)
# Get these from https://comercios.wompi.co after merchant onboarding.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=test_events_...

# ePayco (Colombia: Daviplata only, since Wompi doesn't support it)
EPAYCO_PUBLIC_KEY=your_epayco_public_key
EPAYCO_PRIVATE_KEY=your_epayco_private_key

PORT=4242
